arguments               = $(GRAPH_SEED) $(ORIGINAL_CKPT)

output                  = /home/dani00003/causally-reliable-cbm_graph_pertub/logs/graph_sanity/celeba/frozen_encoder/density.$(ClusterId).$(ProcId).out
